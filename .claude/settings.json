{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run pytest *)"
    ],
    "ask": [
      "Bash(uv run pytest -m integration *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo edit *)",
      "Bash(gh api * --method *)",
      "Bash(gh api * -X *)",
      "Bash(scripts/apply_branch_protection.sh *)",
      "Bash(./scripts/apply_branch_protection.sh *)",
      "Bash(bash scripts/apply_branch_protection.sh *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git reset *--hard*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)"
    ]
  }
}
