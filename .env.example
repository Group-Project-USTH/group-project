# Copy to `.env` (git-ignored) and fill in. Never commit real values.

# --- LLM (any OpenAI-compatible endpoint) ---
# `provider:model` string passed to langchain's init_chat_model.
LLM_MODEL=openai:cx/gpt-5.6-terra
OPENAI_API_KEY=
# Leave empty to use api.openai.com; set it for a third-party/OpenAI-compatible router.
OPENAI_BASE_URL=

# --- Langfuse tracing (optional; tracing is disabled if keys are missing) ---
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com  or your self-hosted URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# development (default) | test | experiment ... keeps data sets apart in Langfuse.
LANGFUSE_TRACING_ENVIRONMENT=development
# Defaults to the git commit of this code (with -dirty for uncommitted changes).
LANGFUSE_RELEASE=
